digraph G {
  rankdir=TB; nodesep=0.3; ranksep=0.32; pad=0.2; dpi=200;
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#5b6b7b", penwidth=1.2, margin="0.14,0.07"];
  edge [fontname="Helvetica", fontsize=10, color="#5b6b7b", arrowsize=0.7];

  trig [label="Trigger: app start, folder added,\nhourly timer (file watcher planned)", fillcolor="#fffbe6", color="#c9b458"];
  scan [label="Walk library roots\n(.wav .flac .aiff .ogg .mp3)"];
  cmp  [label="Same path, size and mtime\nas library_files state?", shape=diamond, style="filled", fillcolor="#f4f1fa", margin="0.05,0.05"];
  keep [label="unchanged\nreuse stored SHA-256"];
  hash [label="hash file (SHA-256)"];
  known [label="clip_id already processed\nwith the same config?", shape=diamond, style="filled", fillcolor="#f4f1fa", margin="0.05,0.05"];
  reuse [label="reuse clean audio + features\n(moved or renamed file)"];
  proc [label="clean + log-mel\n(worker processes)"];
  gone [label="paths no longer on disk\n→ status = deleted"];
  write [label="write raw_files, clips, features,\nlibrary_files (Parquet, atomic)", fillcolor="#f6e7a8", color="#b39a2e"];
  wh [label="rebuild DuckDB → v_library_index\n→ add vectors to FAISS (planned)", fillcolor="#d9ecdf", color="#4f8a63"];

  trig -> scan -> cmp;
  cmp -> keep [label=" yes"];
  cmp -> hash [label=" no"];
  hash -> known;
  keep -> known;
  known -> reuse [label=" yes"];
  known -> proc [label=" no"];
  scan -> gone [style=dashed];
  reuse -> write; proc -> write; gone -> write;
  write -> wh;
}
